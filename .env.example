NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Daily.co
DAILY_API_KEY=your_daily_api_key
NEXT_PUBLIC_DAILY_DOMAIN=your_daily_domain.daily.co
# Webhook HMAC secret returned by scripts/register-daily-webhook.mjs.
# Used by /api/webhooks/daily to verify Daily's signed events.
DAILY_WEBHOOK_SECRET=your_daily_webhook_secret

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (email)
# Sign up at https://resend.com to get a key. Without it, emails are skipped.
RESEND_API_KEY=re_xxxxxxxxx
# Default sender. Requires mindcanopy.in to be verified in Resend
# (Resend dashboard → Domains → add SPF + DKIM DNS records).
# For first-time testing before domain verification, use Resend's
# sandbox sender instead: RESEND_FROM=onboarding@resend.dev
RESEND_FROM=MindCanopy <marketing@mindcanopy.in>
# Sender for admin-originated emails (approvals, account actions).
# Any address @mindcanopy.in works once the domain is verified in Resend.
RESEND_FROM_ADMIN=MindCanopy Admin <admin@mindcanopy.in>
# Signing secret for the Resend webhook (Resend dashboard → Webhooks → add
# endpoint https://mindcanopy.in/api/webhooks/resend → copy the whsec_ secret).
# Populates email_logs.last_status (delivered/opened/clicked/bounced) for the
# admin Emails tab. Without it, the webhook returns 500 and status stays "sent".
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx
# Where new-application notifications land.
ADMIN_EMAIL=admin@mindcanopy.in

# Vercel cron secret — required for all /api/cron/* routes.
# Generate locally with: openssl rand -hex 32
# Set the same value in Vercel → Settings → Environment Variables
# (Production AND Preview scopes). Routes return 500 if unset.
CRON_SECRET=your_cron_secret
